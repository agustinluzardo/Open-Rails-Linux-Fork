<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Description>Free Train Simulator Unit Tests</Description>
    <AssemblyTitle>Free Train Simulator Unit Tests</AssemblyTitle>
    <Configurations>Debug;Release;CodeAnalysis;UpdateContentVersion</Configurations>
    <!-- Only the Toolbox tests need WPF, and they are Windows only. -->
    <UseWPF Condition="'$(RielPlatform)' == 'windows'">true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
  </ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\FreeTrainSimulator.Models.Imported\FreeTrainSimulator.Models.Imported.csproj" />
		<ProjectReference Include="..\..\FreeTrainSimulator.Models\FreeTrainSimulator.Models.csproj" />
		<ProjectReference Include="..\..\FreeTrainSimulator.Updater\FreeTrainSimulator.Updater.csproj" />
		<ProjectReference Include="..\..\FreeTrainSimulator.Graphics\FreeTrainSimulator.Graphics.csproj" />
		<ProjectReference Include="..\..\Orts.Simulation\Orts.Simulation.csproj" />
		<ProjectReference Include="..\..\FreeTrainSimulator.Common\FreeTrainSimulator.Common.csproj" />
		<!-- The Toolbox is WPF; its tests only exist in the Windows build. -->
		<ProjectReference Include="..\..\Toolbox\Toolbox.csproj" Condition="'$(RielPlatform)' == 'windows'" />
	</ItemGroup>
	<ItemGroup Condition="'$(RielPlatform)' != 'windows'">
		<Compile Remove="Toolbox\**\*.cs" />
	</ItemGroup>
</Project>	