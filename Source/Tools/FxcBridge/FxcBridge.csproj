<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Host that lets mgfxc compile shaders under plain Wine.

    mgfxc shells out to "wine64 dotnet c:\fxccs.dll <args>" for every shader, which normally
    means installing the Windows .NET SDK inside a Wine prefix and fetching d3dcompiler_47.dll
    out of a Firefox installer - the two downloads MonoGame's mgfxc_wine_setup.sh performs.

    This is a self contained Windows executable that speaks the same argument protocol and calls
    D3DCompile directly. Installed into the prefix as dotnet.exe it removes both downloads:
    Wine's own d3dcompiler_47 does the compiling, and nothing but Wine has to be installed.

    It is deliberately outside the solution: it is built for Windows, by scripts/build-shaders.sh,
    and is never part of the game.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>fxcbridge</AssemblyName>
    <RootNamespace>FxcBridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Stand alone: the game's versioning and analyzers do not apply. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
