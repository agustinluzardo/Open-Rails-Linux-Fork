msgid "Reading content…"
msgstr "Leyendo el contenido…"

msgid "Choose the Microsoft Train Simulator folder"
msgstr "Elegir la carpeta de Microsoft Train Simulator"

msgid "That folder does not exist"
msgstr "Esa carpeta no existe"

msgid "Nothing was found at {0}. Check the path, and that the disk it is on is mounted."
msgstr "No hay nada en {0}. Revisá la ruta, y que el disco donde está esté montado."

msgid "This does not look like an installation"
msgstr "Esto no parece una instalación"

msgid "{0} has no ROUTES and GLOBAL folders, so its routes would not load. Add it anyway?"
msgstr "{0} no tiene las carpetas ROUTES y GLOBAL, así que sus rutas no cargarían. ¿Agregarla igual?"

msgid "Add anyway"
msgstr "Agregar igual"

msgid "Cancel"
msgstr "Cancelar"

msgid "Using {0}, the installation inside the folder chosen."
msgstr "Se usa {0}, la instalación que está dentro de la carpeta elegida."

msgid "Scanning {0}…"
msgstr "Escaneando {0}…"

msgid "Added {0}: {1}."
msgstr "Se agregó {0}: {1}."

msgid "Added {0}, but no routes were found in it."
msgstr "Se agregó {0}, pero no se encontraron rutas adentro."

msgid "Remove {0}?"
msgstr "¿Quitar {0}?"

msgid "Only the entry is removed. The folder and everything in it stay on disk."
msgstr "Solo se quita de la lista. La carpeta y todo lo que tiene quedan en el disco."

msgid "Remove"
msgstr "Quitar"

msgid "Removing…"
msgstr "Quitando…"

msgid "Removed {0}."
msgstr "Se quitó {0}."

