<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Riel.Launcher.Gui"
        x:Class="Riel.Launcher.Gui.MainWindow"
        Title="Riel"
        Icon="/Assets/riel.png"
        Width="1180" Height="740" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TabControl.mode-tabs TabItem">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.route-title">
      <Setter Property="FontSize" Value="23" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.empty-message">
      <Setter Property="Foreground" Value="{DynamicResource RielSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="20" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- A railway identity, with a full-width tagline that survives translation. -->
    <Border Grid.Row="0" Classes="bar" BorderThickness="0,0,0,1" Padding="24,16">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="{DynamicResource RielRaised}" CornerRadius="12" Padding="7">
            <Image Source="/Assets/riel.png" Width="36" Height="36" />
          </Border>
          <TextBlock Classes="title" Text="Riel" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ToggleSwitch x:Name="DarkSwitch" OnContent="{l:T 'Dark'}" OffContent="{l:T 'Dark'}"
                        AutomationProperties.Name="{l:T 'Dark'}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button x:Name="ContentButton" Content="{l:T 'Content folders'}" />
          <Button x:Name="ToolsButton" Content="{l:T 'Tools'}">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="GetContentButton" Header="{l:T 'Get content'}" />
                <MenuItem x:Name="ManualButton" Header="{l:T 'Manual'}" />
                <Separator />
                <MenuItem x:Name="RouteEditorButton" Header="{l:T 'Riel Route Editor'}" />
                <MenuItem x:Name="ConsistEditorButton" Header="{l:T 'Riel Consist Editor'}" />
                <MenuItem x:Name="ShapeViewerButton" Header="{l:T 'Riel Shape Viewer'}" />
                <MenuItem x:Name="AceConverterButton" Header="{l:T 'Riel ACE Converter'}" />
                <Separator />
                <MenuItem x:Name="TestButton" Header="{l:T 'Test activities'}" />
                <MenuItem x:Name="DoctorButton" Header="{l:T 'Check this computer'}" />
                <MenuItem x:Name="UpdateButton" Header="{l:T 'Check for updates'}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="SettingsButton" Content="{l:T 'Settings'}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="secondary small" Margin="62,0,0,0"
                   Text="{l:T 'Microsoft Train Simulator routes, natively on Linux'}" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="20,18">
      <Grid x:Name="MainArea" ColumnDefinitions="280,*" ColumnSpacing="16">

        <!-- Step 1: a persistent, searchable route library. -->
        <Border Grid.Column="0" Classes="card" Padding="16">
          <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Border Classes="step"><TextBlock Text="1" /></Border>
              <TextBlock Classes="heading" Text="{l:T 'Choose a route'}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Row="1" Classes="secondary small" Text="{l:T 'Route library'}" />
            <TextBox Grid.Row="2" x:Name="RouteFilter" PlaceholderText="{l:T 'Search routes'}"
                     AutomationProperties.Name="{l:T 'Search routes'}" />
            <Grid Grid.Row="3">
              <ListBox x:Name="RouteList" Classes="catalog" AutomationProperties.Name="{l:T 'Routes'}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="l:RouteItem">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                 TextTrimming="WordEllipsis" ToolTip.Tip="{Binding Name}" />
                      <TextBlock Text="{Binding FolderName}" Classes="secondary small" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding FolderName}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="NoRoutes" IsVisible="False" Classes="empty-message" />
            </Grid>
          </Grid>
        </Border>

        <!-- Step 2: the selected route and the three driving modes. -->
        <Border Grid.Column="1" Classes="card" Padding="20,16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Border Classes="step"><TextBlock Text="2" /></Border>
                <TextBlock Classes="heading" Text="{l:T 'Choose a mode'}" VerticalAlignment="Center" />
              </StackPanel>
              <Border Background="{DynamicResource RielRaised}" CornerRadius="9" Padding="14,12">
                <Grid ColumnDefinitions="3,*" ColumnSpacing="12">
                  <Border Background="{DynamicResource RielAccent}" CornerRadius="2" />
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="RouteTitle" Classes="route-title" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis" />
                    <TextBlock x:Name="RouteDescription" Classes="secondary small" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>

            <Border x:Name="SelectionDetailsPanel" DockPanel.Dock="Bottom" Classes="panel" Margin="0,12,0,0" Padding="10,4" MaxHeight="190" IsVisible="False">
              <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                  <TextBlock x:Name="DetailsTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Expander.Header>
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="5" Margin="4,6,4,10">
                    <TextBlock x:Name="DetailsSummary" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailsRoute" Classes="secondary small" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailsDescription" Classes="secondary small" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailsCars" Classes="secondary small" TextWrapping="Wrap" />
                  </StackPanel>
                </ScrollViewer>
              </Expander>
            </Border>

            <TabControl x:Name="ModeTabs" Classes="mode-tabs" AutomationProperties.Name="{l:T 'Choose a mode'}">
              <TabItem Header="{l:T 'Activity'}">
                <Grid Margin="0,12,0,0">
                  <ListBox x:Name="ActivityList" Classes="catalog" AutomationProperties.Name="{l:T 'Activity'}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="l:ActivityItem">
                        <StackPanel Spacing="5">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                     TextTrimming="WordEllipsis" ToolTip.Tip="{Binding Name}" />
                          <TextBlock Text="{Binding Summary}" Classes="secondary small" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="NoActivities" IsVisible="False" Classes="empty-message" MaxWidth="420"
                             Text="{l:T 'This route has no activities. Explore it instead: pick a path and a train in the Explore tab.'}" />
                </Grid>
              </TabItem>

              <TabItem Header="{l:T 'Explore'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="14" RowSpacing="12" Margin="0,14,8,4">
                    <TextBlock Grid.Row="0" Text="{l:T 'Path'}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PathBox" HorizontalAlignment="Stretch" MaxDropDownHeight="320"
                              AutomationProperties.Name="{l:T 'Path'}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="l:PathItem">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" ToolTip.Tip="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="{l:T 'Locomotive'}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LocomotiveBox" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" MaxDropDownHeight="320" AutomationProperties.Name="{l:T 'Locomotive'}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <TextBlock Text="{Binding Name}" MaxWidth="520" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" ToolTip.Tip="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="{l:T 'Train'}" VerticalAlignment="Top" Margin="0,10,0,0" />
                    <Grid Grid.Row="2" Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="8">
                      <TextBox x:Name="ConsistFilter" PlaceholderText="{l:T 'Search trains'}" AutomationProperties.Name="{l:T 'Search trains'}" />
                      <Grid Grid.Row="1">
                        <ListBox x:Name="ConsistList" Classes="catalog" Height="148" AutomationProperties.Name="{l:T 'Train'}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="l:ConsistItem">
                              <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           FontWeight="SemiBold" ToolTip.Tip="{Binding Name}" />
                                <TextBlock Text="{Binding Detail}" Classes="secondary small" TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoConsists" IsVisible="False" Classes="empty-message small" />
                      </Grid>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="{l:T 'Time'}" VerticalAlignment="Center" />
                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,90" ColumnSpacing="8">
                      <ComboBox x:Name="TimePresetBox" HorizontalAlignment="Stretch" PlaceholderText="{l:T 'Suggested times'}"
                                AutomationProperties.Name="{l:T 'Suggested times'}" />
                      <TextBox Grid.Column="1" x:Name="TimeBox" Text="12:00" PlaceholderText="HH:mm" MaxLength="5"
                               AutomationProperties.Name="{l:T 'Time'}" ToolTip.Tip="{l:T 'Choose a suggested time or enter your own (HH:mm).'}" />
                    </Grid>

                    <TextBlock Grid.Row="4" Text="{l:T 'Season'}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="SeasonBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Season'}" />

                    <TextBlock Grid.Row="5" Text="{l:T 'Weather'}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="WeatherBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Weather'}" />

                    <CheckBox Grid.Row="6" Grid.ColumnSpan="2" x:Name="ExploreActivityModeBox" Margin="0,2,0,0"
                              ToolTip.Tip="{l:T 'Use Open Rails activity-style exploration. Normal Explore is recommended for most routes.'}">
                      <TextBlock Text="{l:T 'Explore in Activity Mode'}" TextWrapping="Wrap" />
                    </CheckBox>
                  </Grid>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="{l:T 'Timetable'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="14" RowSpacing="12" Margin="0,14,8,4">
                    <TextBlock Text="{l:T 'Timetable set'}" VerticalAlignment="Center" />
                    <ComboBox x:Name="TimetableBox" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Timetable set'}" />

                    <!-- The Train label and service list share the same row. -->
                    <TextBlock Grid.Row="1" Text="{l:T 'Train'}" VerticalAlignment="Top" Margin="0,10,0,0" />
                    <Grid Grid.Row="1" Grid.Column="1">
                      <ListBox x:Name="TimetableTrainList" Classes="catalog" Height="160" AutomationProperties.Name="{l:T 'Train'}"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="l:TimetableTrainItem">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                         TextTrimming="WordEllipsis" ToolTip.Tip="{Binding Name}" />
                              <TextBlock Text="{Binding Summary}" Classes="secondary small" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock x:Name="NoTimetableTrains" IsVisible="False" Classes="empty-message small" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{l:T 'Day'}" VerticalAlignment="Center" />
                    <ComboBox x:Name="TimetableDayBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Day'}" />
                    <TextBlock Grid.Row="3" Text="{l:T 'Season'}" VerticalAlignment="Center" />
                    <ComboBox x:Name="TimetableSeasonBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Season'}" />
                    <TextBlock Grid.Row="4" Text="{l:T 'Weather'}" VerticalAlignment="Top" Margin="0,10,0,0" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Spacing="8">
                      <ComboBox x:Name="TimetableWeatherBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Weather'}" />
                      <ComboBox x:Name="TimetableWeatherFileBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Weather file'}" />
                    </StackPanel>
                  </Grid>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </DockPanel>
        </Border>
      </Grid>

      <!-- The first-use screen explains exactly which folder Riel needs. -->
      <Border x:Name="EmptyState" IsVisible="False" Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="620" Padding="32,26" Margin="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16">
            <Image Source="/Assets/riel.png" Width="72" Height="72" HorizontalAlignment="Center" />
            <TextBlock Classes="heading" HorizontalAlignment="Center" Text="{l:T 'No content yet'}" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                       Text="{l:T 'Choose the folder where Microsoft Train Simulator is installed: the one that contains ROUTES and GLOBAL. It can be on any disk, or inside a Wine or Proton prefix.'}" />
            <TextBlock x:Name="DetectedHint" IsVisible="False" Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <Button x:Name="UseDetectedButton" IsVisible="False" Classes="accent" Content="{l:T 'Use this one'}" />
              <Button x:Name="AddFirstFolderButton" Content="{l:T 'Choose a folder'}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Keep progress legible in either theme and prevent interactions during work. -->
      <Border x:Name="BusyOverlay" IsVisible="False" Background="{DynamicResource RielOverlay}" CornerRadius="14">
        <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24" Padding="28">
          <StackPanel Spacing="18">
            <TextBlock x:Name="BusyText" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" />
            <ProgressBar x:Name="BusyProgress" Minimum="0" Maximum="100" Height="6" MinWidth="280" />
          </StackPanel>
        </Border>
      </Border>
    </Grid>

    <!-- Step 3: visible selection feedback beside the single primary action. -->
    <Border Grid.Row="2" Classes="bar" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Border Classes="step"><TextBlock Text="3" /></Border>
          <TextBlock Classes="heading" Text="{l:T 'Start your journey'}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="SelectionHint" Grid.Row="1" Classes="secondary" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis" />
        <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button x:Name="ResumeButton" Content="{l:T 'Continue saved game'}" />
          <Button x:Name="PlayButton" Classes="accent" MinWidth="150" MinHeight="44" HorizontalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <TextBlock Text="{l:T 'Play'}" VerticalAlignment="Center" />
              <Path Width="14" Height="14" Data="M 4,2 L 12,8 L 4,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" x:CompileBindings="False" Stretch="Uniform" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Button x:Name="ProblemsButton" IsVisible="False" MinHeight="28" Padding="10,4" />
          <TextBlock x:Name="StatusText" Grid.Column="1" Classes="secondary small" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
