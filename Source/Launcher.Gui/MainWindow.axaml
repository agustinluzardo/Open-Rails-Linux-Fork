<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Riel.Launcher.Gui"
        x:Class="Riel.Launcher.Gui.MainWindow"
        Title="Riel"
        Icon="/Assets/riel.png"
        Width="1060" Height="700" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Classes="bar" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Image Source="/Assets/riel.png" Width="40" Height="40" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="title" Text="Riel" />
            <TextBlock Classes="secondary small" Text="{l:T 'Microsoft Train Simulator routes, natively on Linux'}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ToggleSwitch x:Name="DarkSwitch" OnContent="{l:T 'Dark'}" OffContent="{l:T 'Dark'}"
                        VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button x:Name="ContentButton" Content="{l:T 'Content folders'}" />
          <Button x:Name="DoctorButton" Content="{l:T 'Check this computer'}" />
          <Button x:Name="SettingsButton" Content="Settings" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1">

      <Grid x:Name="MainArea" ColumnDefinitions="330,*">

        <!-- Routes -->
        <DockPanel Grid.Column="0" Margin="16,16,8,16">
          <TextBlock DockPanel.Dock="Top" Classes="heading" Text="{l:T 'Routes'}" Margin="0,0,0,8" />
          <TextBox DockPanel.Dock="Top" x:Name="RouteFilter" PlaceholderText="{l:T 'Search routes'}" Margin="0,0,0,8" />
          <ListBox x:Name="RouteList">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="l:RouteItem">
                <StackPanel Margin="0,3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding FolderName}" Classes="secondary small" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- The chosen route -->
        <DockPanel Grid.Column="1" Margin="8,16,16,16">
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
            <TextBlock x:Name="RouteTitle" Classes="heading" TextWrapping="Wrap" />
            <TextBlock x:Name="RouteDescription" Classes="secondary" TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis" />
          </StackPanel>

          <TabControl x:Name="ModeTabs">

            <TabItem Header="{l:T 'Activity'}">
              <Grid RowDefinitions="*,Auto" Margin="0,8,0,0">
                <ListBox x:Name="ActivityList">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="l:ActivityItem">
                      <StackPanel Margin="0,3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Summary}" Classes="secondary small" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoActivities" IsVisible="False" Classes="secondary" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                           Text="{l:T 'This route has no activities. Explore it instead: pick a path and a train in the Explore tab.'}" />
                <Border Grid.Row="1" Classes="panel" Margin="0,10,0,0" MaxHeight="170">
                  <ScrollViewer>
                    <TextBlock x:Name="ActivityDescription" TextWrapping="Wrap" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </TabItem>

            <TabItem Header="{l:T 'Explore'}">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,12,0,0">
                <TextBlock Grid.Row="0" Text="{l:T 'Path'}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PathBox" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="1" Text="{l:T 'Train'}" VerticalAlignment="Top" Margin="0,18,16,0" />
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                  <TextBox DockPanel.Dock="Top" x:Name="ConsistFilter" PlaceholderText="{l:T 'Search trains'}" Margin="0,0,0,6" />
                  <ListBox x:Name="ConsistList" MinHeight="120">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="l:ConsistItem">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,1">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Classes="secondary small" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>

                <TextBlock Grid.Row="2" Text="{l:T 'Time'}" VerticalAlignment="Center" Margin="0,12,16,0" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TimeBox" Text="12:00" Width="110" HorizontalAlignment="Left" Margin="0,12,0,0" />

                <TextBlock Grid.Row="3" Text="{l:T 'Season'}" VerticalAlignment="Center" Margin="0,12,16,0" />
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="SeasonBox" MinWidth="180" Margin="0,12,0,0" />

                <TextBlock Grid.Row="4" Text="{l:T 'Weather'}" VerticalAlignment="Center" Margin="0,12,16,0" />
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="WeatherBox" MinWidth="180" Margin="0,12,0,0" />
              </Grid>
            </TabItem>
            <TabItem Header="{l:T 'Timetable'}">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="0,12,0,0">
                <TextBlock Text="{l:T 'Timetable set'}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ComboBox x:Name="TimetableBox" Grid.Column="1" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="1" Text="{l:T 'Train'}" VerticalAlignment="Center" Margin="0,12,14,0" />
                <ListBox x:Name="TimetableTrainList" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="l:TimetableTrainItem">
                      <StackPanel Spacing="2" Margin="0,3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" Classes="secondary small" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3" Text="{l:T 'Day'}" VerticalAlignment="Center" Margin="0,12,14,0" />
                <ComboBox x:Name="TimetableDayBox" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" />
                <TextBlock Grid.Row="4" Text="{l:T 'Season'}" VerticalAlignment="Center" Margin="0,12,14,0" />
                <ComboBox x:Name="TimetableSeasonBox" Grid.Row="4" Grid.Column="1" Margin="0,12,0,0" />
                <TextBlock Grid.Row="5" Text="{l:T 'Weather'}" VerticalAlignment="Center" Margin="0,12,14,0" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                  <ComboBox x:Name="TimetableWeatherBox" MinWidth="155" />
                  <ComboBox x:Name="TimetableWeatherFileBox" MinWidth="190" />
                </StackPanel>
              </Grid>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Grid>

      <!-- Nothing configured yet -->
      <StackPanel x:Name="EmptyState" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                  MaxWidth="560" Spacing="14" Margin="24">
        <Image Source="/Assets/riel.png" Width="96" Height="96" HorizontalAlignment="Center" />
        <TextBlock Classes="heading" HorizontalAlignment="Center" Text="{l:T 'No content yet'}" />
        <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                   Text="{l:T 'Choose the folder where Microsoft Train Simulator is installed: the one that contains ROUTES and GLOBAL. It can be on any disk, or inside a Wine or Proton prefix.'}" />
        <TextBlock x:Name="DetectedHint" IsVisible="False" Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Button x:Name="UseDetectedButton" IsVisible="False" Classes="accent" Content="{l:T 'Use this one'}" />
          <Button x:Name="AddFirstFolderButton" Content="{l:T 'Choose a folder'}" />
        </StackPanel>
      </StackPanel>

      <!-- Scanning -->
      <Border x:Name="BusyOverlay" IsVisible="False" Background="{DynamicResource SystemControlBackgroundAltMediumHighBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Spacing="10">
          <TextBlock x:Name="BusyText" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
          <ProgressBar x:Name="BusyProgress" Minimum="0" Maximum="100" Height="6" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2" Classes="bar" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid ColumnDefinitions="*,Auto">
        <Grid ColumnDefinitions="Auto,*" Margin="0,0,16,0">
          <Button x:Name="ProblemsButton" IsVisible="False" Margin="0,0,12,0" />
          <TextBlock x:Name="StatusText" Grid.Column="1" Classes="secondary" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="ResumeButton" Content="{l:T 'Continue saved game'}" />
          <Button x:Name="PlayButton" Classes="accent" MinWidth="150" FontWeight="SemiBold"
                  HorizontalContentAlignment="Center" Content="{l:T 'Play'}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
