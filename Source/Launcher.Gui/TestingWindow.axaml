<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Riel.Launcher.Gui"
        x:Class="Riel.Launcher.Gui.TestingWindow"
        Title="{l:T 'Test activities'}"
        Width="980" Height="620" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Classes="heading" Text="{l:T 'Activity testing'}" />
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{l:T 'Launch activities automatically and record load errors, warnings, load time and FPS.'}" />
      </StackPanel>
      <CheckBox x:Name="DefaultSettingsBox" Grid.Column="1" VerticalAlignment="Center"
                Content="{l:T 'Use default test settings'}" />
    </Grid>

    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,14,0,14">
      <ProgressBar x:Name="Progress" IsVisible="False" Height="5" Minimum="0" Maximum="1" />
      <ListBox x:Name="ActivityList" Grid.Row="1" Margin="0,10,0,0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="l:TestingActivityItem">
            <Grid ColumnDefinitions="2.2*,2.2*,1.1*,1.2*,0.8*,0.8*" Margin="4,3">
              <TextBlock Text="{Binding Route}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Activity}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding Result}" />
              <TextBlock Grid.Column="3" Text="{Binding Errors}" />
              <TextBlock Grid.Column="4" Text="{Binding Load}" />
              <TextBlock Grid.Column="5" Text="{Binding FPS}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="SummaryButton" Content="{l:T 'Open summary'}" />
        <Button x:Name="LogButton" Content="{l:T 'Open log'}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CancelTestButton" Content="{l:T 'Cancel test'}" />
        <Button x:Name="TestSelectedButton" Content="{l:T 'Test selected'}" />
        <Button x:Name="TestAllButton" Classes="accent" Content="{l:T 'Test all'}" />
        <Button x:Name="CloseButton" Content="{l:T 'Close'}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
