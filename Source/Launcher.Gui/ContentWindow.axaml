<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Riel.Launcher.Gui"
        x:Class="Riel.Launcher.Gui.ContentWindow"
        Title="{l:T 'Content folders'}"
        Icon="/Assets/riel.png"
        Width="740" Height="520" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="24,20">

    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
      <TextBlock Classes="heading" Text="{l:T 'Content folders'}" />
      <TextBlock Classes="secondary" TextWrapping="Wrap"
                 Text="{l:T 'Each one is a Microsoft Train Simulator installation, or a copy of one: the folder that holds ROUTES and GLOBAL. It can be on any disk, or inside a Wine or Proton prefix. Riel only ever reads it.'}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
      <Border Classes="panel">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
          <TextBlock Text="{l:T 'Folder'}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBox Grid.Column="1" x:Name="PathBox" PlaceholderText="{l:T 'Paste a path, or browse for it'}" />
          <Button Grid.Column="2" x:Name="BrowseButton" Content="{l:T 'Browse…'}" Margin="8,0,0,0" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="1" Text="{l:T 'Name'}" VerticalAlignment="Center" Margin="0,8,12,0" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" Margin="0,8,0,0" />
          <Button Grid.Row="1" Grid.Column="2" x:Name="AddButton" Classes="accent" Content="{l:T 'Add'}"
                  Margin="8,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </Grid>
      </Border>
      <TextBlock x:Name="StatusText" Classes="secondary" TextWrapping="Wrap" />
      <ProgressBar x:Name="Progress" IsVisible="False" Minimum="0" Maximum="100" Height="6" />
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Button x:Name="RemoveButton" Content="{l:T 'Remove'}" />
        <Button Grid.Column="1" x:Name="RescanButton" Content="{l:T 'Scan again'}" Margin="8,0,0,0" />
        <Button Grid.Column="3" x:Name="CloseButton" Content="{l:T 'Close'}" IsCancel="True" MinWidth="90"
                HorizontalContentAlignment="Center" />
      </Grid>
    </StackPanel>

    <Grid>
      <ListBox x:Name="FolderList">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="l:FolderItem">
            <StackPanel Margin="0,3">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Path}" Classes="secondary small" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="NoFolders" Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Text="{l:T 'No folders yet.'}" />
    </Grid>
  </DockPanel>
</Window>
