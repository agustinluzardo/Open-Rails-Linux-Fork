<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>Riel</id>
    <version>1.0.0</version>
    <title>Riel</title>
    <authors>Riel contributors</authors>
	<license type="expression">GPL-3.0-or-later</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectUrl>https://github.com/agustinluzardo/Riel-Linux</projectUrl>
    <icon>Program\riel.png</icon>
    <description>Riel Linux train simulator</description>
  </metadata>
  <files>
    <file src=".\..\Program\**\*.*" target="Program\" />
    <file src="Launcher.Gui\Assets\riel.png" target="Program\" />
  </files>
</package>
