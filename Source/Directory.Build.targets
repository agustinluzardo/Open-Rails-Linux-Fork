<Project>
	<!--
	  Open Rails Linux Fork - platform fix-ups.

	  Imported after every project body, so it can rewrite the item groups the
	  upstream project files declare. Keeping the platform switches here instead
	  of editing each .csproj keeps the delta against upstream FreeTrainSimulator
	  small and makes merges from upstream cheap.
	-->

	<!-- Graphics backend: replace the Direct3D 11 package with the OpenGL one. -->
	<ItemGroup Condition="'$(RielGraphicsBackend)' != 'WindowsDX'">
		<RielUsesMonoGame Include="@(PackageReference->WithMetadataValue('Identity','MonoGame.Framework.WindowsDX'))" />
	</ItemGroup>
	<ItemGroup Condition="'$(RielGraphicsBackend)' != 'WindowsDX' AND '@(RielUsesMonoGame)' != ''">
		<PackageReference Remove="MonoGame.Framework.WindowsDX" />
		<PackageReference Include="MonoGame.Framework.$(RielGraphicsBackend)" Version="$(MonoGameVersion)" />
	</ItemGroup>

	<!--
	  Windows-only NuGet packages.

	  GetText.NET.WindowsForms  WinForms translation helper; the Linux build has no WinForms UI.
	  System.Management         WMI; replaced by /proc and /sys readers in Common/Native/Linux.
	  RailDriver                wraps the Windows-only piehid64.dll; replaced by the hidraw
	                            reader in Common/Input/Linux.
	  OpenAL-Soft               ships soft_oal.dll; on Linux we bind the distro's libopenal.so.1.
	-->
	<ItemGroup Condition="'$(RielPlatform)' != 'windows'">
		<PackageReference Remove="GetText.NET.WindowsForms" />
		<PackageReference Remove="GetText.NET.Wpf" />
		<PackageReference Remove="System.Management" />
		<PackageReference Remove="RailDriver" />
		<PackageReference Remove="OpenAL-Soft" />
	</ItemGroup>

	<!-- Win32 resources (icon, manifest) cannot be embedded when not targeting Windows. -->
	<PropertyGroup Condition="'$(RielPlatform)' != 'windows'">
		<ApplicationIcon />
		<ApplicationManifest />
		<OutputType Condition="'$(OutputType)' == 'WinExe'">Exe</OutputType>
	</PropertyGroup>

	<!--
	  Per-platform sources. A file named *.Windows.cs is compiled only for the
	  Windows build and *.Unix.cs only for the Linux/macOS build, so the two
	  implementations of a partial class can live side by side.
	-->
	<ItemGroup Condition="'$(RielPlatform)' == 'windows'">
		<Compile Remove="**/*.Unix.cs" />
		<None Include="**/*.Unix.cs" />
	</ItemGroup>
	<ItemGroup Condition="'$(RielPlatform)' != 'windows'">
		<Compile Remove="**/*.Windows.cs" />
		<None Include="**/*.Windows.cs" />
	</ItemGroup>

	<!--
	  Shaders.

	  The Windows build compiles the .fx sources in each project's own PostBuild step. The Linux
	  build carries prebuilt .mgfx files instead, because MonoGame's effect compiler needs
	  Microsoft's HLSL compiler and so cannot run here unaided - see scripts/build-shaders.sh,
	  which is what produces them.

	  They are declared as content of the simulator rather than copied in a target, so that both
	  a build and a publish pick them up.
	-->
	<PropertyGroup Condition="'$(RielPlatform)' != 'windows'">
		<RielPrebuiltShaderDirectory Condition="'$(RielPrebuiltShaderDirectory)' == ''">$(MSBuildThisFileDirectory)Shaders/prebuilt/$(RielGraphicsBackend.Replace('DesktopGL','OpenGL'))</RielPrebuiltShaderDirectory>
	</PropertyGroup>
	<ItemGroup Condition="'$(RielPlatform)' != 'windows' AND '$(MSBuildProjectName)' == 'ActivityRunner'">
		<Content Include="$(RielPrebuiltShaderDirectory)/*.mgfx"
		         Link="Content/%(Filename)%(Extension)"
		         CopyToOutputDirectory="PreserveNewest"
		         CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<Target Name="RielWarnOnMissingShaders" BeforeTargets="Build"
	        Condition="'$(RielPlatform)' != 'windows' AND '$(MSBuildProjectName)' == 'ActivityRunner'">
		<Warning Condition="!Exists('$(RielPrebuiltShaderDirectory)')"
		         Text="No prebuilt shaders in $(RielPrebuiltShaderDirectory). Run scripts/build-shaders.sh; the simulator cannot render without them." />
	</Target>

	<!-- Compilation symbols so shared sources can branch on the target platform. -->
	<PropertyGroup>
		<DefineConstants Condition="'$(RielPlatform)' != 'windows'">$(DefineConstants);RIEL_UNIX</DefineConstants>
		<DefineConstants Condition="'$(RielGraphicsBackend)' == 'DesktopGL'">$(DefineConstants);RIEL_DESKTOPGL</DefineConstants>
	</PropertyGroup>

</Project>
