<Project>
  <PropertyGroup Condition="'$(RielPlatform)' != 'windows'">
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <ImportWindowsDesktopTargets>false</ImportWindowsDesktopTargets>
    <ApplicationIcon />
    <ApplicationManifest />
    <OutputType Condition="'$(OutputType)' == 'WinExe'">Exe</OutputType>
    <DefineConstants>$(DefineConstants);RIEL_UNIX;RIEL_DESKTOPGL</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(RielPlatform)' != 'windows'">
    <PackageReference Remove="MonoGame.Framework.WindowsDX" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
    <PackageReference Remove="System.Management" />
    <PackageReference Remove="RailDriver" />
    <Reference Remove="System.Windows.Forms" />
    <Reference Remove="PresentationFramework" />
    <Reference Remove="System.DirectoryServices" />
  </ItemGroup>

  <ItemGroup Condition="'$(RielPlatform)' != 'windows' AND '$(MSBuildProjectName)' == 'Orts.Common'">
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(RielPlatform)' == 'windows'">
    <Compile Remove="**/*.Unix.cs" />
    <None Include="**/*.Unix.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(RielPlatform)' != 'windows'">
    <Compile Remove="**/*.Windows.cs" />
    <None Include="**/*.Windows.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RielPlatform)' != 'windows' AND '$(MSBuildProjectName)' == 'RunActivity'">
    <Compile Remove="Viewer3D/Debugging/DebugViewerForm.cs" />
    <Compile Remove="Viewer3D/Debugging/DebugViewerForm.Designer.cs" />
    <Compile Remove="Viewer3D/Debugging/SoundDebugForm.cs" />
    <Compile Remove="Viewer3D/Debugging/SoundDebugForm.Designer.cs" />
    <Compile Remove="Viewer3D/Debugging/TimetableWindow.cs" />
    <Compile Remove="Viewer3D/Map/MapForm.cs" />
    <Compile Remove="Viewer3D/Map/MapForm.Designer.cs" />
    <Compile Remove="Viewer3D/Map/MapDataProvider.cs" />
    <Compile Remove="Viewer3D/Map/MapThemeProvider.cs" />
    <EmbeddedResource Remove="Viewer3D/Debugging/DebugViewerForm.resx" />
    <EmbeddedResource Remove="Viewer3D/Debugging/SoundDebugForm.resx" />
    <EmbeddedResource Remove="Viewer3D/Map/MapForm.resx" />
  </ItemGroup>
</Project>
